# Model name for sentence transformer
EMBEDDING_MODEL_NAME="Qwen/Qwen3-Embedding-0.6B""

# Choose your LLM provider: "openai", "anthropic", "gemini", or "ollama"
LLM_PROVIDER=ollama

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_DIM=3072

# Ollama (only needed if LLM_PROVIDER=ollama)
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIM=1024
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

